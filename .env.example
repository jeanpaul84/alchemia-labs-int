# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   source .env
#
# Uses `export` so the same file works for both the Python extract scripts and
# the dbt CLI (dbt reads the process environment, not .env files).

# Path to your service account key. Keep the key OUTSIDE this repo so a
# .gitignore mistake can never leak it.
export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.gcp/thameswood-sa-key.json"

# Your BigQuery sandbox project. Read by extract/config.py.
export BQ_PROJECT_ID="gin-accounts-recommendation"
